---
import Layout from "../layouts/Layout.astro";
import { FACE, ABOUT_ME } from "../data/constants";
import Header from "../components/Header.astro";
import FredopenSide from "../components/Fredopen/Fredopen-side.astro";
import FredopenMain from "../components/Fredopen/Fredopen-main.astro";
import ArtdecoList from "../components/Artdeco/Artdeco-list.astro";
import ContactsList from "../components/Contacts/Contacts-list.astro";
import SkillsList from "../components/Skills/Skills-list.astro";
import NavList from "../components/Nav/Nav-list.astro";
import ProjectsList from "../components/Projects/Projects-list.astro";
import LanguagesList from "../components/Languages/Languages-list.astro";
import MusicPlayer from "../components/Music-player.astro";
import BlogList from "../components/BlogList.astro";
import { EXPERIENCE_LIST } from "../data/experience";
import { CONTACTS_LIST } from "../data/contacts";
import { SKILLS_LIST } from "../data/skills";
import { NAVIGATION_LIST } from "../data/navigation";
import { PROJECTS_LIST } from "../data/projects";
import { LANGUAGES_LIST } from "../data/Languages";
---

<Layout>
  <div class="container">
    <aside class="aside">
      <div class="resizer"></div>

      <div class="aside-default">
        <pre class="image self-type" data-speed="0">{FACE}</pre>

        <section class="contact">
          <h3 class="glitch section-title" data-text="Contact">Contact</h3>
          <ContactsList items={CONTACTS_LIST} />
        </section>

        <section class="about-me">
          <h3 class="glitch section-title" data-text="About me">About me</h3>
          <div class="section-text">{ABOUT_ME}</div>
        </section>

        <section class="skills">
          <h3 class="glitch section-title" data-text="Skills">Skills</h3>
          <SkillsList items={SKILLS_LIST} />
        </section>
      </div>

      <FredopenSide />
    </aside>

    <main class="main">
      <Header />

      <NavList items={NAVIGATION_LIST} />

      <div class="nav-content">
        <section class="experience">
          <ArtdecoList items={EXPERIENCE_LIST} />
        </section>
        
        <section class="blog">
          <BlogList/>
        </section>

        <section class="projects">
          <ProjectsList items={PROJECTS_LIST} />
        </section>

        <section class="languages">
          <LanguagesList items={LANGUAGES_LIST} />
        </section>

        <FredopenMain />
      </div>
    </main>
  </div>

  <MusicPlayer />
</Layout>

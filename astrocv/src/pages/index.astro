---
import Layout from "../layouts/Layout.astro";
import { FACE, ABOUT_ME } from "../model/constants";
import ArtdecoList from "../components/Artdeco/Artdeco-list.astro";
import ContactsList from "../components/Contacts/Contacts-list.astro";
import SkillsList from "../components/Skills/Skills-list.astro";
import ProjectsList from "../components/Projects/Projects-list.astro";
import MusicPlayer from "../components/Music-player.astro";
import LanguagesList from "../components/Languages/Languages-list.astro";
import { experience } from "../components/Artdeco/experience";
import { CONTACTS_LIST } from "../components/Contacts/contacts";
import { SKILLS_LIST } from "../components/Skills/skills";
import { PROJECTS_LIST } from "../components/Projects/projects";
import { LANGUAGES_LIST } from "../components/Languages/Languages";
import Header from "../components/Header.astro";
---

<Layout>
  <div class="container">
    <aside class="aside">
      <div class="resizer"></div>

      <div class="aside-default">
        <pre class="image self-type" data-speed="0">{FACE}</pre>

        <section class="contact">
          <h3 class="glitch section-title" data-text="Contact">Contact</h3>
          <ContactsList items={CONTACTS_LIST} />
        </section>

        <section class="about-me">
          <h3 class="glitch section-title" data-text="About me">About me</h3>
          <div class="section-text">{ABOUT_ME}</div>
        </section>

        <section class="skills">
          <h3 class="glitch section-title" data-text="Skills">Skills</h3>
          <SkillsList items={SKILLS_LIST} />
        </section>
      </div>

      <div class="aside-editors">
        <div class="editor html">
          <div class="editor-title">
            <span>HTML</span>
            <div class="editor-title-tools">
              <button class="btn btn-primary" onclick="loadFile()">Load file</button>
              <button class="btn btn-primary" onclick="saveFile()">Save file</button>
            </div>
          </div>
          <div id="html-editor"></div>
        </div>

        <div class="editor css">
          <div class="editor-title">
            <span>CSS</span>
          </div>
          <div id="css-editor"></div>
        </div>

        <div class="editor js">
          <div class="editor-title">
            <span>JS</span>
          </div>
          <div id="js-editor"></div>
        </div>
      </div>
    </aside>
    <main class="main">
      <Header />

      <ul class="nav">
        <div class="cat-container">
          <div class="cat"></div>
        </div>

        <li class="nav-item experience">
          <a class="nav-link" href="#">Experience</a>
        </li>

        <li class="nav-item projects">
          <a class="nav-link" href="#">Projects</a>
        </li>

        <li class="nav-item languages">
          <a class="nav-link" href="#">Languages</a>
        </li>
      </ul>

      <div class="nav-content">
        <section class="experience">
          <h3 class="glitch section-title" data-text="Experience">
            Experience
          </h3>

          <ArtdecoList items={experience} />
        </section>

        <section class="projects">
          <h3 class="glitch section-title" data-text="Projects">Projects</h3>

          <ProjectsList items={PROJECTS_LIST} />
        </section>

        <section class="languages">
          <h3 class="glitch section-title" data-text="Languages">Languages</h3>

          <LanguagesList items={LANGUAGES_LIST} />
        </section>

        <section class="fredopen">
          <iframe src="" frameborder="0"></iframe>
        </section>
      </div>
    </main>
  </div>

  <MusicPlayer />
</Layout>

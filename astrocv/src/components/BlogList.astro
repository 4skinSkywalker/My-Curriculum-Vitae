---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));
---

<div class="timeline">{
    posts.map((post) => (
        post.data.type === 'review'
            ? (<div class="timeline-item">
                <div class="timeline-main">
                    <div class="timeline-author">
                        <div class="timeline-author-icon">
                            <img src={post.data.creatorIcon} alt="Creator Icon" />
                        </div>
                        <div class="timeline-author-name">{post.data.createdBy}</div>
                    </div>

                    <article class="review-card">
                        <div class="review-card-image">
                            {post.data.image && <img src={post.data.image} alt={post.data.title} />}
                        </div>
                        <div class="review-card-main">
                            <div class="review-card-date">{post.data.pubDate}</div>
                            <h3 class="review-card-title">{post.data.title}</h3>
                            <div class="review-card-info">{post.data.age}, {post.data.author}</div>

                            <div class="review-card-text">
                                <p>{post.data.description}</p>
                            </div>
                            
                            <ul class="review-card-rating">
                                <li class={post.data.rating === 'poor'      ? "rating-item rating-item--active" : "rating-item"}>Poor</li>
                                <li class={post.data.rating === 'mediocre'  ? "rating-item rating-item--active" : "rating-item"}>Mediocre</li>
                                <li class={post.data.rating === 'good'      ? "rating-item rating-item--active" : "rating-item"}>Good</li>
                                <li class={post.data.rating === 'excellent' ? "rating-item rating-item--active" : "rating-item"}>Excellent</li>
                            </ul>
                        </div>
                    </article>
                </div>
            </div>)
            : (<div class="timeline-item">
                <div class="timeline-main">
                    <div class="timeline-author">
                        <div class="timeline-author-icon">
                            <img src={post.data.creatorIcon} alt="Creator Icon" />
                        </div>
                        <div class="timeline-author-name">{post.data.createdBy}</div>
                    </div>
                    
                    <article class="article-card">
                        <h3 class="article-title">{post.data.title}</h3>
                        <div class="article-author">{post.data.pubDate}</div>

                        <ul class="article-tags">
                            {post.data.tags && post.data.tags.map((tag) => (
                                <li class="article-tag">#{tag}</li>
                            ))}
                        </ul>

                        <div class="article-text">
                            <p>{post.data.description}</p>
                        </div>

                        <a href={`/blog/${post.id}/`} class="btn btn-primary ms-auto">Read more</a>
                    </article>
                </div>
            </div>)
    ))
}</div>

<style>
    .timeline {
        display: flex;
        flex-direction: column;
        max-width: 800px;
        margin-inline: auto;
        
        .timeline-item {
            display: flex;
            gap: 1rem;
            
            .timeline-main {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                flex-grow: 1;
                padding-bottom: 2rem;
                
                .timeline-author {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-top: 1rem;
                    
                    .timeline-author-icon {
                        width: 42px;
                        aspect-ratio: 1/1;
                        border-radius: 50%;
                    }
                    
                    .timeline-author-name {
                        font-size: 1.25rem;
                        font-weight: bold;
                    }
                }
                
                .review-card {
                    display: flex;
                    gap: 1rem;
                    background: #11111b;
                    padding: 1rem;
                    color: #fff;

                    @media (max-width: 1024px) {
                        flex-direction: column;
                    }
                    
                    .review-card-image {
                        height: 275px;
                        aspect-ratio: 10/16;

                        img {
                            width: 100%;
                            height: 100%;
                            object-fit: contain;
                            object-position: center;
                        }
                    }
                    
                    .review-card-main {
                        display: flex;
                        flex-direction: column;
                        gap: 0.75rem;
                        
                        .review-card-title {
                            font-size: 1.5rem;
                        }
                        
                        .review-card-text {
                            margin-top: 1rem;
                        }
                        
                        .review-card-rating {
                            display: flex;
                            justify-content: space-between;
                            margin-top: auto;
                            padding: 0.3rem;
                            margin-top: 1rem;

                            @media (max-width: 1024px) {
                                flex-direction: column;
                            }
                            
                            .rating-item {
                                padding: 0.6rem 1.2rem;
                                
                                &.rating-item--active {
                                    background: rgba(var(--primary-color));
                                    color: #000;
                                }
                            }
                        }
                    }
                }
                
                .article-card {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                    background: #11111b;
                    border: 2px dashed rgba(var(--primary-color));
                    padding: 1rem 1.5rem;
                    
                    .article-title {
                        font-size: 1.5rem;
                        margin-bottom: -0.5rem;
                    }
                    
                    .article-tags {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.5rem;
                        margin-bottom: 1rem;
                        
                        .article-tag {
                            background: #444;
                            padding: 0.5rem 1rem;
                        }
                    }
                    
                    .article-text {
                        display: flex;
                        flex-direction: column;
                        gap: 1rem;
                    }
                }
            }
        }
    }
</style>